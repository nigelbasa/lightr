#!/bin/sh
# Post-install for the lightr package.
#
# Nothing here is silenced. An earlier version ended every command with
# ">/dev/null 2>&1 || true", so an install that could not write its own
# config still printed "Lightr installed. Next steps:" -- which is
# exactly the failure the preflight checks exist to stop.
set -e

USER=lightr
GROUP=lightr
CONFIG=/etc/lightr/config.yaml

case "$1" in
  configure)
    if ! getent group "$GROUP" >/dev/null; then
      addgroup --system "$GROUP"
    fi
    if ! getent passwd "$USER" >/dev/null; then
      adduser --system --ingroup "$GROUP" --no-create-home \
              --home /var/lib/lightr --shell /usr/sbin/nologin "$USER"
    fi

    # Dovecot delivers into the Maildir root and reads the Sieve
    # scripts Lightr writes, so it needs to share the group.
    if getent passwd dovecot >/dev/null; then
      adduser dovecot "$GROUP" >/dev/null 2>&1 || true
    fi

    for dir in /var/lib/lightr /var/log/lightr /var/mail/lightr /var/lib/lightr/sieve; do
      mkdir -p "$dir"
      chown "$USER:$GROUP" "$dir"
    done
    chmod 750 /var/lib/lightr /var/log/lightr
    chmod 2770 /var/mail/lightr /var/lib/lightr/sieve

    mkdir -p /etc/lightr
    chown root:"$GROUP" /etc/lightr
    chmod 750 /etc/lightr

    # Writes the commented config if there is none, migrates the
    # schema, generates Dovecot's secrets and installs its
    # configuration. Idempotent, and it never replaces the config file
    # -- so this is also the upgrade path.
    if ! lightr setup; then
      echo "lightr setup failed. The package is installed but not configured." >&2
      echo "Fix what it reported, then run: lightr setup" >&2
      exit 1
    fi

    # The config holds the database password and the Dovecot internal
    # key. The service reads it as the lightr user.
    chown root:"$GROUP" "$CONFIG"
    chmod 640 "$CONFIG"

    if [ -d /run/systemd/system ]; then
      systemctl daemon-reload >/dev/null 2>&1 || true
      systemctl try-restart dovecot.service >/dev/null 2>&1 || true
    fi

    # Report rather than assert: this runs before the service starts,
    # and preflight is the thing that knows what "cannot work" means.
    lightr preflight || true

    cat <<'EOF'

Lightr is installed and configured.

  systemctl enable --now lightr     start the engine
  lightr setup --hostname <name>    set the name this server calls itself
  lightr domain create <domain>     add your first domain

Configuration is /etc/lightr/config.yaml.
EOF
    ;;
esac

#DEBHELPER#
exit 0
