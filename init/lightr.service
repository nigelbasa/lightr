[Unit]
Description=Lightr Email Server
Documentation=https://github.com/nigelbasa/lightr
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lightr
Group=lightr
ExecStart=/usr/bin/lightr serve --config /etc/lightr/lightr.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes

# Allow binding to privileged ports if needed
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Data directories
ReadWritePaths=/var/lib/lightr
ReadWritePaths=/var/log/lightr

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lightr

[Install]
WantedBy=multi-user.target
