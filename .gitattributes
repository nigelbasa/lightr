# Default: let git normalise text in the repository.
* text=auto

# These run on Linux. A shell script or systemd unit checked out with
# CRLF fails at runtime -- "bad interpreter: /bin/sh^M" -- and the
# Debian maintainer scripts here are executed by dpkg during install,
# so the failure lands on the operator, not on us.
*.sh          text eol=lf
*.service     text eol=lf
*.lua         text eol=lf
*.sieve       text eol=lf
packaging/debian/postinst  text eol=lf
packaging/debian/prerm     text eol=lf
packaging/debian/postrm    text eol=lf

# Python and config are read by tools that accept either, but keeping
# them LF matches the deployment target.
*.py    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.toml  text eol=lf
*.sql   text eol=lf
*.md    text eol=lf
*.mako  text eol=lf

# Never touch these.
*.png binary
*.jpg binary
*.pdf binary
